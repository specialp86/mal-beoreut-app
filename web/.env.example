# STT provider: mock (default, no keys needed) | openai | naver | google
# Set this once Phase 0 (../docs/phase0-stt-comparison.md) picks a winner.
STT_PROVIDER=mock

OPENAI_API_KEY=
NAVER_CLOVA_CLIENT_ID=
NAVER_CLOVA_CLIENT_SECRET=
GOOGLE_STT_API_KEY=

# Optional: personalized improvement tip on the result screen (Claude API).
# Leave blank to skip this feature entirely — nothing else depends on it.
ANTHROPIC_API_KEY=
