# Copy to .env and fill in. Any API left blank is skipped by compare-stt.mjs.

# OpenAI Whisper API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Naver Cloud Platform - Clova Speech Recognition (CSR)
# Console: https://console.ncloud.com/naver-service/application
NAVER_CLOVA_CLIENT_ID=
NAVER_CLOVA_CLIENT_SECRET=

# Google Cloud Speech-to-Text (API key auth, simplest for a one-off script)
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_STT_API_KEY=
